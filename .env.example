# --- Ma'lumotlar bazasi -------------------------------------------------------
# Lokal: postgresql://postgres:PAROL@localhost:5432/tamirlash
# Render: Dashboard → PostgreSQL → Connections → External Database URL
DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/tamirlash
# Render uchun true, lokal PostgreSQL uchun false
DB_SSL=false
# DB_POOL_MAX=10

# --- Ilova --------------------------------------------------------------------
PORT=3000
# NODE_ENV=production
# Tashqi manzil: QR-kodlar shu manzilga olib boradi (masalan https://tamir.onrender.com)
APP_URL=http://localhost:3000
# Sessiya cookie'larini imzolash uchun kamida 32 belgili tasodifiy satr (production'da majburiy)
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Muddat hisoblanadigan ish kunlari: 1 = Dushanba ... 7 = Yakshanba (6 kunlik hafta: 1,2,3,4,5,6)
ISH_KUNLARI=1,2,3,4,5
# Rasmlar saqlanadigan papka (Render'da doimiy disk yo'lini bering)
# UPLOAD_DIR=./uploads
# Proksi ortida (Render) — production'da avtomatik yoqiladi
# TRUST_PROXY=true
# Ichki rejalashtiruvchi (muddat nazorati, avtomatik yopish) — har 5 daqiqada
# INTERNAL_JOBS=true

# --- Birinchi administrator (npm run migrate yaratadi) ------------------------
ADMIN_LOGIN=admin
# Production'da majburiy (kamida 8 belgi). Lokal rejimda bo'sh bo'lsa: admin12345 (birinchi kirishda almashtiriladi)
ADMIN_PAROL=

# --- Telegram bot (ixtiyoriy; bo'sh bo'lsa — faqat saytdagi bildirishnomalar) ---
# @BotFather → /newbot → token va bot nomi
TG_BOT_TOKEN=
TG_BOT_USERNAME=
# Webhook maxfiy kaliti (kamida 16 belgi); yaratish: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TG_WEBHOOK_SECRET=
# Lokal kompyuterda (https manzil yo'q) webhook o'rniga: TG_POLLING=true
# TG_POLLING=false

# --- Zaxira nusxalar ----------------------------------------------------------
# ZAXIRA_DIR=./zaxira
# Kunlik avtomatik zaxira va nechta nusxa saqlanadi
# ZAXIRA_AVTO=true
# ZAXIRA_SAQLASH=7

# --- Testlar ------------------------------------------------------------------
# npm test uchun ALOHIDA baza (nomida "test" bo'lishi shart, har test faylida tozalanadi!)
# TEST_DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/tamirlash_test
