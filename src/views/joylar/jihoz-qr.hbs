<div class="print-toolbar no-print">
  <a href="{{orqaga}}">← {{sarlavha}}</a>
  <form method="get" class="jqr-filter">
    {{#each turlar}}<label class="check"><input type="checkbox" name="tur" value="{{id}}" {{#if tanlangan}}checked{{/if}}> {{nomi}} ({{qrli}}/{{soni}})</label>{{/each}}
    <button class="btn btn-ghost btn-sm" type="submit">Ko'rsatish</button>
  </form>
  <span>{{kartalar.length}} ta yorliq · A4 varaqqa 21 tadan</span>
  <button class="btn btn-primary" type="button" data-chop {{#unless kartalar.length}}disabled{{/unless}}>Chop etish</button>
</div>

<div class="jqr-panel no-print">
  {{> flash}}
  {{#if qrsiz}}
  <form method="post" action="{{manzil}}" class="alert alert-warn jqr-yarat">
    {{> csrf}}
    {{#each tanlanganTurlar}}<input type="hidden" name="tur" value="{{this}}">{{/each}}
    <span><strong>{{qrsiz}} ta jihozda QR-kod yo'q</strong>{{#if tanlanganTurlar.length}} (tanlangan turlar){{/if}}. Yaratilgach, yorliqlari shu yerda chiqadi.</span>
    <button class="btn btn-primary btn-sm" type="submit">QR-kod yaratish ({{qrsiz}} ta)</button>
  </form>
  {{/if}}
</div>

{{#if kartalar.length}}
<div class="jqr-sheet">
  {{#each kartalar}}
  <div class="jqr-label">
    <div class="qr">{{{svg}}}</div>
    <div class="jqr-text">
      <strong>{{tur}} {{belgi}}</strong>
      <span>{{bino}} · {{xona}}-xona</span>
      {{#if inventar_raqami}}<span>{{inventar_raqami}}</span>{{/if}}
      <span>Buzilsa — skanerlang</span>
      <small>{{manzil}}</small>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<div class="container">
  {{#if jami}}
    {{> bosh matn="Hali QR-kod yaratilmagan. Yuqoridagi «QR-kod yaratish» tugmasini bosing — kerak bo'lsa, avval jihoz turlarini tanlang."}}
  {{else}}
    {{> bosh matn="Bu yerda jihoz yo'q."}}
  {{/if}}
</div>
{{/if}}
