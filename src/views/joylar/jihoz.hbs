<div class="page-head">
  <div>
    <a class="back" href="/xonalar/{{j.xona_id}}">← {{j.bino}} · {{j.xona}}-xona</a>
    <h1>{{j.tur}} {{j.belgi}}</h1>
    <div class="badges">
      {{#if j.faol}}<span class="badge holat-yopilgan">Faol</span>{{else}}<span class="badge">Hisobdan chiqarilgan</span>{{/if}}
      {{#if muammoli}}<span class="badge badge-warn">Muammoli: 90 kunda {{soni90}} marta buzilgan</span>{{/if}}
    </div>
  </div>
  <div class="row">
    {{#if j.faol}}<a class="btn btn-ghost" href="/arizalar/yangi?xona={{j.xona_id}}&jihoz={{j.id}}">Ariza berish</a>{{/if}}
    <a class="btn btn-ghost" href="/admin/jihozlar/{{j.id}}/tahrir">Tahrirlash</a>
  </div>
</div>

{{#if muammoli}}
<div class="alert alert-warn">Bu jihoz tez-tez buzilmoqda — uni almashtirish tavsiya etiladi.</div>
{{/if}}

<div class="layout-2">
  <div class="main-col">
    <section class="card">
      <dl class="kv">
        <dt>Joyi</dt><dd><a href="/xonalar/{{j.xona_id}}">{{j.bino}} · {{j.qavat}}-qavat · {{j.xona}}-xona</a></dd>
        <dt>Inventar raqami</dt><dd>{{default j.inventar_raqami "—"}}</dd>
        <dt>Ro'yxatga olingan</dt><dd>{{sana j.yaratilgan}}</dd>
        <dt>Jami arizalar</dt><dd>{{arizalar.length}}</dd>
      </dl>
    </section>

    <section>
      <div class="section-head"><h2>Ta'mir tarixi</h2></div>
      {{#if arizalar.length}}
        <div class="list">{{#each arizalar}}{{> ariza-row}}{{/each}}</div>
      {{else}}
        {{> bosh matn="Bu jihoz bo'yicha ariza tushmagan."}}
      {{/if}}
    </section>
  </div>

  <aside class="side-col">
    <section class="card qr-card">
      <h2>Jihoz QR-kodi</h2>
      <div class="qr">{{{svg}}}</div>
      <p class="small muted break">{{qrManzil}}</p>
      <p class="small muted">Skanerlansa, ariza faqat shu jihoz uchun beriladi. Ochiq arizasi bo'lsa, yangi xabar o'shanga qo'shiladi.</p>
      <div class="stack-tight">
        <a class="btn btn-ghost btn-sm" href="/jihozlar/{{j.id}}/qr.svg">{{> icon name="download"}}SVG yuklab olish</a>
        <a class="btn btn-ghost btn-sm" href="/admin/xonalar/{{j.xona_id}}/jihoz-qr" target="_blank" rel="noopener">Xonaning jihoz QR-kodlari</a>
        <form method="post" action="/admin/jihozlar/{{j.id}}/qr-yangilash" data-tasdiq="Yangi QR-kod yaratilsinmi? Eskisi ishlamay qoladi.">{{> csrf}}<button class="btn btn-ghost btn-sm" type="submit">Yangi QR-kod yaratish</button></form>
      </div>
    </section>
  </aside>
</div>
