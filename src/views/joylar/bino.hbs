<div class="page-head">
  <div>
    <a class="back" href="/admin/binolar">← Binolar</a>
    <h1>{{bino.nomi}}</h1>
    <p class="muted">{{#if bino.manzil}}{{bino.manzil}} · {{/if}}{{bino.qavatlar_soni}} qavat · {{xonaSoni}} xona</p>
  </div>
  <div class="row">
    <a class="btn btn-primary" href="/admin/xonalar/yangi?bino={{bino.id}}">{{> icon name="plus"}}Xona qo'shish</a>
    {{#if xonaSoni}}<a class="btn btn-ghost" href="/admin/binolar/{{bino.id}}/qr" target="_blank" rel="noopener">{{> icon name="qr"}}QR-kodlarni chop etish</a>{{/if}}
    <a class="btn btn-ghost" href="/admin/binolar/{{bino.id}}/tahrir">Tahrirlash</a>
  </div>
</div>

{{#each qavatlar}}
<section class="floor">
  <h2>{{qavat}}-qavat</h2>
  <div class="rooms">
    {{#each xonalar}}
    <a class="room{{#unless faol}} is-off{{/unless}}{{#if ochiq}} has-open{{/if}}" href="/xonalar/{{id}}">
      <strong>{{raqam}}</strong>
      <span class="muted small">{{xonaTuri turi}}</span>
      <span class="small">{{jihozlar}} jihoz{{#if ochiq}} · <b class="text-accent">{{ochiq}} ochiq</b>{{/if}}{{#unless faol}} · nofaol{{/unless}}</span>
    </a>
    {{/each}}
  </div>
</section>
{{else}}
  {{> bosh matn="Bu binoda hali xona yo'q."}}
  {{#unless xonaSoni}}
  <form method="post" action="/admin/binolar/{{bino.id}}/ochirish" data-tasdiq="Binoni o'chirasizmi?">{{> csrf}}<button class="btn btn-ghost" type="submit">Binoni o'chirish</button></form>
  {{/unless}}
{{/each}}
