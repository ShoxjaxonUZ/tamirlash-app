<div class="page-head"><h1>Yangi ariza</h1></div>

{{#if bosqich1}}
<ol class="steps" aria-label="Bosqichlar"><li class="on" aria-current="step">1. Joy</li><li>2. Muammo</li></ol>
{{> errors}}
<form method="get" action="/arizalar/yangi" class="card stack" data-xona-tanlash>
  <p class="muted">Buzilgan jihoz qaysi xonada? Xona eshigida QR-kod bo'lsa, uni skanerlang — bu bosqich o'tkazib yuboriladi.</p>
  <div class="grid-3">
    <label class="field js-only"><span>Bino</span>
      <select data-filtr="bino"><option value="">Barcha binolar</option>{{#each binolar}}<option value="{{id}}">{{nomi}}</option>{{/each}}</select>
    </label>
    <label class="field js-only"><span>Qavat</span>
      <select data-filtr="qavat"><option value="">Barcha qavatlar</option></select>
    </label>
    <label class="field"><span>Xona</span>
      <select name="xona" required data-xona>
        <option value="">— tanlang —</option>
        {{#each xonalar}}<option value="{{id}}" data-bino="{{bino_id}}" data-qavat="{{qavat}}">{{bino}} · {{raqam}}-xona ({{qavat}}-qavat)</option>{{/each}}
      </select>
    </label>
  </div>
  {{#unless xonalar.length}}<p class="alert alert-warn">Tizimda hali xonalar kiritilmagan. Xo'jalik bo'limiga murojaat qiling.</p>{{/unless}}
  <div><button class="btn btn-primary" type="submit">Davom etish →</button></div>
</form>

{{else}}
<ol class="steps" aria-label="Bosqichlar"><li class="done"><a href="/arizalar/yangi">1. Joy</a></li><li class="on" aria-current="step">2. Muammo</li></ol>

<div class="card place">
  {{> icon name="pin"}}
  <div><strong>{{xona.bino}} · {{xona.raqam}}-xona</strong><span class="muted">{{xona.qavat}}-qavat · {{xonaTuri xona.turi}}</span></div>
  <a class="btn btn-ghost btn-sm" href="/arizalar/yangi">O'zgartirish</a>
</div>

{{#if jihoz}}
<div class="card place">
  {{> icon name="qr"}}
  <div><strong>{{jihoz.tur}} {{jihoz.belgi}}</strong><span class="muted">{{#if jihoz.inventar_raqami}}Inventar: {{jihoz.inventar_raqami}} · {{/if}}ariza faqat shu jihoz uchun</span></div>
  <a class="btn btn-ghost btn-sm" href="/arizalar/yangi?xona={{xona.id}}">Boshqa jihoz</a>
</div>
{{/if}}

{{#if mavjud}}
<section class="card dup mavjud">
  <h2>{{> icon name="alert"}}Bu jihoz bo'yicha ariza allaqachon bor</h2>
  <div class="row-tight"><strong>{{mavjud.raqam}}</strong>{{> holat h=mavjud.holat}}<span class="muted small">{{mavjud.xabar_berganlar}} kishi xabar bergan · {{vaqt mavjud.yaratilgan}}</span></div>
  <p>{{qisqa mavjud.tavsif 200}}</p>
  {{#if mavjud.meniki}}
    <p class="muted">Bu sizning arizangiz. Qo'shimcha ma'lumot yoki rasm bo'lsa, pastda yozing — u shu arizaga qo'shiladi.</p>
    <a class="btn btn-ghost btn-sm" href="/arizalar/{{mavjud.id}}">Arizani ochish</a>
  {{else if mavjud.qoshilganman}}
    <p class="muted">Siz bu arizaga qo'shilgansiz. Yana ma'lumot bo'lsa, pastda yozing.</p>
    <a class="btn btn-ghost btn-sm" href="/arizalar/{{mavjud.id}}">Arizani ochish</a>
  {{else}}
    <p class="muted">Yangi ariza ochilmaydi: shu muammoni ko'rgan bo'lsangiz, <b>«Menda ham shu muammo»</b> ni bosing. Qo'shimcha ma'lumot yoki rasm bo'lsa — pastda yozing, u shu arizaga qo'shiladi va siz ham holatini kuzatasiz.</p>
    <form method="post" action="/arizalar/{{mavjud.id}}/menda-ham">{{> csrf}}<button class="btn" type="submit">Menda ham shu muammo</button></form>
  {{/if}}
</section>
{{/if}}

{{#unless jihoz}}{{#if ochiq.length}}
<section class="card dup">
  <h2>{{> icon name="alert"}}Bu xonada allaqachon xabar berilgan muammolar</h2>
  <p class="muted">Muammoingiz shulardan biri bo'lsa, yangi ariza bermang — <b>"Menda ham shu muammo"</b> ni bosing. Holat o'zgarsa, sizga ham xabar keladi.</p>
  <ul class="dup-list">
    {{#each ochiq}}
    <li data-tur="{{tur_id}}">
      <div>
        <div class="row-tight"><strong>{{raqam}}</strong>{{> holat h=holat}}<span>{{jihozNomi this}}</span><span class="badge badge-warn" data-mos-belgi hidden>Siz tanlagan tur</span></div>
        <p>{{qisqa tavsif 150}}</p>
        <small class="muted">{{xabar_berganlar}} kishi xabar bergan · {{vaqt yaratilgan}}</small>
      </div>
      {{#if meniki}}<a class="btn btn-ghost btn-sm" href="/arizalar/{{id}}">Mening arizam</a>
      {{else if qoshilganman}}<a class="btn btn-ghost btn-sm" href="/arizalar/{{id}}">Qo'shilgansiz ✓</a>
      {{else}}<form method="post" action="/arizalar/{{id}}/menda-ham">{{> csrf}}<button class="btn btn-sm" type="submit">Menda ham shu muammo</button></form>{{/if}}
    </li>
    {{/each}}
  </ul>
</section>
{{/if}}{{/unless}}

{{> errors}}
<form method="post" action="/arizalar" enctype="multipart/form-data" class="card stack" data-ariza-forma>
  {{> csrf}}
  <input type="hidden" name="xona_id" value="{{xona.id}}">

  {{#if jihoz}}
  <input type="hidden" name="jihoz_id" value="{{jihoz.id}}">
  {{else}}
  {{#if jihozBor}}
  <label class="field"><span>Qaysi jihoz?</span>
    <select name="jihoz_id" data-jihoz>
      <option value="">Ro'yxatda yo'q — turini tanlayman</option>
      {{#each jihozGuruhlari}}<optgroup label="{{tur}}">{{#each items}}<option value="{{id}}" {{#if (eq id @root.qiymat.jihoz_id)}}selected{{/if}}>{{tur}} {{belgi}}{{#if ochiq_ariza}} — ariza bor ({{ochiq_ariza}}){{/if}}</option>{{/each}}</optgroup>{{/each}}
    </select>
    <small class="hint">Jihozdagi raqam yoki belgi bo'yicha tanlang (masalan, "#3"). «Ariza bor» jihozni tanlasangiz, xabaringiz o'sha arizaga qo'shiladi.</small>
  </label>
  {{/if}}

  <label class="field" data-tur>
    <span>Jihoz turi{{#if jihozBor}} <em>(ro'yxatda bo'lmasa)</em>{{/if}}</span>
    <select name="tur_id" data-tur-tanlov>
      <option value="">— tanlang —</option>
      {{#each turlar}}<option value="{{id}}" {{#if (eq id @root.qiymat.tur_id)}}selected{{/if}}>{{nomi}}</option>{{/each}}
    </select>
  </label>
  {{/if}}

  <label class="field"><span>Xonadagi aniq joyi <em>(ixtiyoriy)</em></span>
    <input name="joy_izohi" maxlength="200" value="{{qiymat.joy_izohi}}" placeholder="Masalan: deraza tomondagi 2-qator">
  </label>

  <label class="field"><span>{{#if mavjud}}Qo'shimcha ma'lumot{{else}}Muammo tavsifi{{/if}}</span>
    <textarea name="tavsif" rows="4" minlength="10" maxlength="2000" required data-sanagich
      placeholder="{{#if mavjud}}Masalan: endi umuman yoqilmayapti, xonada juda issiq{{else}}Nima bo'ldi? Masalan: kompyuter yonmayapti, quvvat tugmasi bosilganda hech narsa bo'lmaydi{{/if}}">{{qiymat.tavsif}}</textarea>
    <small class="hint" data-sanagich-matn>Kamida 10 belgi</small>
  </label>

  <fieldset class="field">
    <legend>Muhimlik darajasi</legend>
    <div class="choices">
      {{#each muhimliklar}}
      <label class="choice choice-{{kalit}}">
        <input type="radio" name="muhimlik" value="{{kalit}}" {{#if (eq kalit @root.qiymat.muhimlik)}}checked{{/if}} required>
        <span><strong>{{nomi}}</strong><small>{{izoh}}</small><small class="muted">Bajarish muddati: {{muddat}}</small></span>
      </label>
      {{/each}}
    </div>
    {{#if mavjud}}<small class="hint">Yuqoriroq muhimlik tanlasangiz, arizaning muhimligi oshadi va muddati yaqinlashadi.</small>{{/if}}
  </fieldset>

  {{> rasm-tanlash max=maxRasm sarlavha="Rasmlar"}}

  <div><button class="btn btn-primary btn-lg" type="submit">{{#if mavjud}}Xabarni arizaga qo'shish{{else}}Arizani yuborish{{/if}}</button></div>
</form>
{{/if}}
